# Скопіюйте в .env та заповніть реальними значеннями. Файл .env не комітиться в git.

# === Telegram бот ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMINISTRATORS=[123456789, 987654321]

# === База даних ===
DATABASE_URL=sqlite+aiosqlite:///./databases/finance_bot.db
# Окрема БД для клієнтів і замовлень Cosmy (таблиці clients, client_orders, client_order_lines)
CLIENTS_DATABASE_URL=sqlite+aiosqlite:///./databases/cosmy_clients.db
PRODUCTS_DATABASE_URL=sqlite+aiosqlite:///./databases/products.db
# Резервні копії (локально databases/backups + щодня о 01:30 у Telegram адмінам; /backup_db у боті)
# DB_BACKUP_DIR=./databases/backups
# DB_BACKUP_KEEP_COUNT=5
# DB_BACKUP_TELEGRAM_MAX_BYTES=50331648
# На VPS (немає .venv з git): bash scripts/run_db_backup.sh
# або: cd ~/CosmyFinancesBot && PYTHONPATH=. python3 scripts/run_db_backup.py
# (потрібен той самий Python/venv, що й для uvicorn/бота)

# === Веб-апка ===
# Сервер: http://185.233.44.170 (додайте :PORT якщо не 80)
# 0.0.0.0 = доступ з мережі за IP сервера
WEB_HOST=0.0.0.0
# Порт: 8000 — за замовч., 80 — стандартний HTTP (потрібні права адміна: sudo)
WEB_PORT=8000
# Планувальник (Mono/NovaPay синк, крон). На другому воркері uvicorn — 0, щоб не дублювати cron і JWT refresh.
ENABLE_SCHEDULER=1
# Парсер цін: порожньо = скрейп локально; інакше scrape-worker (БД/крони лишаються тут)
# Таймаути/ліміти — у config.py і ParserService/app/config.py
# PARSER_SERVICE_URL=https://cosmyparser.telebots.site
# PARSER_API_KEY=shared-secret-with-parser-service
WEB_USERNAME=admin
WEB_PASSWORD=your_strong_password
# Менеджер: доступ тільки до Транзакцій, Готівки, Категорій, Непідтверджених (без Головної, Статистики, Звітів, Синхронізації)
WEB_MANAGER_USERNAME=manager
WEB_MANAGER_PASSWORD=manager
WEB_SECRET_KEY=your_secret_key_min_32_chars
# Cookie тільки по HTTPS: true для продакшену, false для локального HTTP
WEB_SECURE_COOKIE=false
# Публічний URL веб-панелі (Telegram-кнопка «Клієнти», абсолютні посилання на /static у листах).
# Якщо тут *.ngrok-free.app — поштові клієнти часто показують «порожню» іконку картинки: ngrok видає
# сторінку-попередження замість файлу для запитів без заголовка ngrok-skip-browser-warning (листові
# програми його не надсилають). Для реальної розсилки краще звичайний домен (cosmy.com.ua або VPS HTTPS).
WEB_PUBLIC_BASE_URL=
# API-ключ для зовнішніх endpoint відправки листів (welcome/abandoned-cart). Рекомендовано заповнити.
MARKETING_API_KEY=
# Фід клієнтів Cosmy (за замовчуванням — analytics_customer.xml)
COSMY_CUSTOMERS_FEED_URL=https://cosmy.com.ua/price/analytics_customer.xml

# === Маркетинг: аналіз реклами (Google Ads, Meta, Search Console) ===
# Ключі — у settings/marketing.json (не в .env). Див. settings/README.md
# cp settings/marketing.example.json settings/marketing.json
# cp settings/gsc_service_account.example.json settings/gsc_service_account.json
# MARKETING_CONFIG_PATH=settings/marketing.json  # за замовчуванням
# При першому запуску ключі з .env можуть автоматично перенестись у settings/marketing.json

# === Resend (email-розсилки клієнтам) ===
RESEND_API_BASE=https://api.resend.com
RESEND_API_KEY=re_xxxxxxxxx
# Маркетингові розсилки з панелі та promo-signup
RESEND_FROM_EMAIL=mailingspromo@cosmy.com.ua
RESEND_FROM_NAME=Cosmy
# Транзакційні тригери: замовлення, кошик, оплата, price-drop, welcome
RESEND_FROM_ORDERS=orders@cosmy.com.ua
# Куди відповідатимуть клієнти на «Reply»
RESEND_REPLY_TO=cosmy.com.ua@gmail.com
# URL відписки в листах — у config.py (EMAIL_UNSUBSCRIBE_URL), не в .env
# Обмеження Host (рекомендовано для продакшену): cosmyfinances.telebots.site
WEB_ALLOWED_HOSTS=
# production — вимагає MARKETING_API_KEY для /api/mailings/*
ENV=development
RESEND_USER_AGENT=cosmy-finances-bot/1.0

# ФОП (Monobank / NovaPay) налаштовуються у веб-адмінці → розділ ФОП.
# Токени та сертифікати зберігаються в основній БД (таблиця fops), не в .env.
